# Copy this file to .env and insert your own key.
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
# Current model name from DeepSeek API docs; other available models may be used.
DEEPSEEK_MODEL=deepseek-flash
# Standard endpoint works with non-strict function schemas.
DEEPSEEK_BASE_URL=https://api.deepseek.com
